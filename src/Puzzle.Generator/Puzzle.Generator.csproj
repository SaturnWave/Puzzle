    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Puzzle.Generator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Puzzle.Core\Puzzle.Core.csproj" />
