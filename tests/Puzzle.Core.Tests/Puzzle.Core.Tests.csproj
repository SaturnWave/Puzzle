<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Puzzle.Core.Tests</RootNamespace>
    <!-- Sentence-style test names and inline test data arrays are intentional. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Puzzle.Core\Puzzle.Core.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Bot\Puzzle.Bot.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Generator\Puzzle.Generator.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Tooling\Puzzle.Tooling.csproj" />
    <!-- The attempt recorder's session lifecycle lives in the web lab. -->
    <ProjectReference Include="..\..\src\Puzzle.Web\Puzzle.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The attempt-record wire format, pinned for every writer of it (the lab here, the Unity game later). -->
    <None Include="..\fixtures\attempt-records.schema-1.jsonl" Link="fixtures\attempt-records.schema-1.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
