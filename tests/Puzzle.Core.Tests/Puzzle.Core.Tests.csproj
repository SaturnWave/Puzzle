<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Puzzle.Core.Tests</RootNamespace>
    <!-- Sentence-style test names and inline test data arrays are intentional. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Unity project's engine trace has no Unity dependency; the tests pin what it prints on this runtime. -->
    <Compile Include="..\..\unity\Assets\Scripts\Engine\EngineTrace.cs" Link="Unity\EngineTrace.cs" />
    <!-- Nor have the game's screen layout and its stage clock: where a board lies, and how animations take their time. -->
    <Compile Include="..\..\unity\Assets\Scripts\Layout\ScreenView.cs" Link="Unity\ScreenView.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\ScreenLayout.cs" Link="Unity\ScreenLayout.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Stage\Tween.cs" Link="Unity\Tween.cs" />
    <!-- Nor have the outline the gilt frame is drawn along and the rule that hangs the wall lamps. -->
    <Compile Include="..\..\unity\Assets\Scripts\Boards\BoardOutline.cs" Link="Unity\BoardOutline.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\SconcePlace.cs" Link="Unity\SconcePlace.cs" />
    <!-- Nor has what turns a move's events into a timed script for the view, the clock that plays it, and what a finger on the board means. -->
    <Compile Include="..\..\unity\Assets\Scripts\Play\Timeline.cs" Link="Unity\Play\Timeline.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\FallLaw.cs" Link="Unity\Play\FallLaw.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\Tempo.cs" Link="Unity\Play\Tempo.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\Cue.cs" Link="Unity\Play\Cue.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\PieceLedger.cs" Link="Unity\Play\PieceLedger.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\Strike.cs" Link="Unity\Play\Strike.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\Volley.cs" Link="Unity\Play\Volley.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\FinalePace.cs" Link="Unity\Play\FinalePace.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\TurnChoreographer.cs" Link="Unity\Play\TurnChoreographer.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Play\BoardPointer.cs" Link="Unity\Play\BoardPointer.cs" />
    <!-- Nor has the way from one level to the next: a player's progress, a decided game's result and its words (with the plaque's figures and the list of drawings they name). -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\PlayerProgress.cs" Link="Unity\Flow\PlayerProgress.cs" />
    <!-- Nor has the document the progress is saved as, with the rule that reads the layout of the game before the museum. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\ProgressDocument.cs" Link="Unity\Flow\ProgressDocument.cs" />
    <!-- Nor has what an attempt's events do to the progress by the economy's rules, and the wall clock those rules count real time by. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\AttemptLedger.cs" Link="Unity\Flow\AttemptLedger.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\WallClock.cs" Link="Unity\Flow\WallClock.cs" />
    <!-- Nor have the attempt record's line as the game writes it, the phone's log of those lines, and the document of the phone's random id. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\AttemptLine.cs" Link="Unity\Flow\AttemptLine.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\AttemptLogFile.cs" Link="Unity\Flow\AttemptLogFile.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\DeviceDocument.cs" Link="Unity\Flow\DeviceDocument.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\LevelResult.cs" Link="Unity\Flow\LevelResult.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\AttemptWords.cs" Link="Unity\Flow\AttemptWords.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Gallery\HudFigures.cs" Link="Unity\Gallery\HudFigures.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Art\PieceArt.cs" Link="Unity\Art\PieceArt.cs" />
    <!-- Nor have the museum's screens in what they show and say of a player's progress (the room's wall, the map's floor plan, the pieces a win gives), and where they put it on a screen. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\MuseumWords.cs" Link="Unity\Flow\MuseumWords.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\PieceReward.cs" Link="Unity\Flow\PieceReward.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\RoomWall.cs" Link="Unity\Flow\RoomWall.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\FloorPlan.cs" Link="Unity\Flow\FloorPlan.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\PageLayout.cs" Link="Unity\Layout\PageLayout.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\HallLayout.cs" Link="Unity\Layout\HallLayout.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\MapLayout.cs" Link="Unity\Layout\MapLayout.cs" />
    <!-- Nor have the jigsaw a painting is restored with (what lies on its table and its tray, when a piece drops in) and the collection, in what they hold and where they put it. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\JigsawTable.cs" Link="Unity\Flow\JigsawTable.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\FramePlace.cs" Link="Unity\Layout\FramePlace.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\JigsawLayout.cs" Link="Unity\Layout\JigsawLayout.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\CollectionLayout.cs" Link="Unity\Layout\CollectionLayout.cs" />
    <!-- Nor has the list of what is drawn over what: the tests pin the places that a mistake has shown to matter. -->
    <Compile Include="..\..\unity\Assets\Scripts\DrawOrder.cs" Link="Unity\DrawOrder.cs" />
    <!-- Nor have the lettering's styles with the typeface each is set in, and the letters the game can write. -->
    <Compile Include="..\..\unity\Assets\Scripts\Art\GalleryArt.cs" Link="Unity\Art\GalleryArt.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Art\Typeface.cs" Link="Unity\Art\Typeface.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Art\LetterSet.cs" Link="Unity\Art\LetterSet.cs" />
    <!-- Nor have the rules of the controls several screens share: what a booster's disc shows, how a row of pips is set out, how amounts and waits are written. -->
    <Compile Include="..\..\unity\Assets\Scripts\Screens\BoosterFace.cs" Link="Unity\Screens\BoosterFace.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Screens\PipRowPlan.cs" Link="Unity\Screens\PipRowPlan.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\NumberWords.cs" Link="Unity\Flow\NumberWords.cs" />
    <!-- Nor has the wallet row of the museum's pages: what it shows of a wallet at an instant, its words, where its parts stand. -->
    <Compile Include="..\..\unity\Assets\Scripts\Flow\WalletView.cs" Link="Unity\Flow\WalletView.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Flow\WalletWords.cs" Link="Unity\Flow\WalletWords.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Layout\WalletRowLayout.cs" Link="Unity\Layout\WalletRowLayout.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Puzzle.Core\Puzzle.Core.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Bot\Puzzle.Bot.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Museum\Puzzle.Museum.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Meta\Puzzle.Meta.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Generator\Puzzle.Generator.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Tooling\Puzzle.Tooling.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Bank\Puzzle.Bank.csproj" />
    <ProjectReference Include="..\..\src\Puzzle.Economy\Puzzle.Economy.csproj" />
    <!-- The attempt recorder's session lifecycle lives in the web lab. -->
    <ProjectReference Include="..\..\src\Puzzle.Web\Puzzle.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The attempt-record wire format, pinned for every writer of it (the lab here, the Unity game later). -->
    <None Include="..\fixtures\attempt-records.schema-1.jsonl" Link="fixtures\attempt-records.schema-1.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same format with the optional action list, which the Unity game writes by hand: both writers are held to it. -->
    <None Include="..\fixtures\attempt-records.actions.jsonl" Link="fixtures\attempt-records.actions.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
