{
  // The default economy with the session habit the recordings showed: the two recorded players had a median of
  // 5 attempts a session, which is about 10 minutes, where the default ceiling of 20 minutes gives about 8.
  "extends": "default.json",
  "name": "short-sessions",
  "habit": {
    // Minutes after which no new attempt starts in a session. [recorded, two players]
    "sessionCeilingMinutes": 10
  }
}
