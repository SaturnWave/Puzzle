{
  // The default economy with sessions that last until the lives are gone, or an hour at most: the habit in which
  // lives are what stops a player. It shows what lives cost when the 20-minute ceiling does not end a session first.
  "extends": "default.json",
  "name": "long-sessions",
  "habit": {
    // Minutes after which no new attempt starts in a session. [assumed 2, the ceiling raised]
    "sessionCeilingMinutes": 60
  }
}
